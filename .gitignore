creds.js
images
node_modules/
audio/
external/
infinitestreams/
.DS_Store

# Media folders stay out of git EXCEPT the small web-ready set hypermoon
# needs at runtime, so a fresh clone can run every effect (moon discs, vajra
# proxies, mosaic tiles, eye backdrop, sonic loop). Masters stay ignored.
loops/*
!loops/3d moon/
loops/3d moon/*
!loops/3d moon/web/
!loops/VAJRA DORJE ANIMATIONS/
loops/VAJRA DORJE ANIMATIONS/*
!loops/VAJRA DORJE ANIMATIONS/web/

# Derived from the track log and the day folders by `npm run hermes:annals:index`,
# purely so annals-curator.html has something to fetch. Regenerated in a second, and
# it lists every private file by name, so it does not belong in a public repo.
data/hermes/annals-index.json

# Output of scripts/optimize-loops.mjs: browser-playable copies of the masters
# above, a few gigabytes of them. Regenerable from the originals in one command,
# so it is derived media rather than source.
loops-web/

assets/*
!assets/esoteric-geometries-circles-warp.gif
# The public programme for the week, which the annals page embeds above the days. It is
# the one thing under assets/hermes-annals/ meant to be seen: everything else in there is
# other people's faces and 277 MB of source media. Without this exception the publisher
# quietly drops the poster on any clone but this laptop, and the page loses it silently.
!assets/hermes-annals/
assets/hermes-annals/*
!assets/hermes-annals/program/
# Cached photographs of the art the days name, from Burning Man's own archive. Kept in
# the repo so a build is reproducible off a clone: without them the publisher drops the
# pictures silently and the art lists go back to being bare names. `npm run
# hermes:annals:art` refetches, but only while the archive still answers.
!assets/hermes-annals/art/
# The Seven Circles of Hermes, the Source Library booklet the annals offer as a download.
# It is 6.9 MB of somebody else's scanned plates and there is no script that can refetch
# it, so unlike the art cache it has to live here or the download link goes nowhere.
!assets/hermes-annals/reading/
# Hand triage of the scraped GifCities library: a few hundred bytes of
# judgement that would otherwise have to be made by eye again after every
# scrape. The gifs themselves stay ignored — npm run gifs fetches them back,
# and their names are checksummed, so the marks still match.
!assets/gifcities/
assets/gifcities/*
!assets/gifcities/curation.json
# Which stretches of the xfeeefeee clips are worth playing on their own: the
# timestamps took an eye to find, while the cuts they describe are rebuilt by
# npm run clips:cut from masters that are ignored anyway.
!assets/xfeeefeee/
assets/xfeeefeee/*
!assets/xfeeefeee/segments.json
# Clips sampled from elsewhere on the web. Same deal: the videos are ignored,
# but which video and which stretch of it took an eye to settle, and npm run
# clips:web fetches and re-cuts the lot from this one file.
!assets/clips/
assets/clips/*
!assets/clips/sources.json
# The starter kit: low-bandwidth copies of the two libraries that are otherwise
# fetched by script, so a fresh clone runs the show instead of orbiting nothing
# in front of a black iris. About 10MB, rebuilt by npm run starter.
!assets/starter/
!assets/starter/**
# Guest-mark examples: a few hundred bytes of SVG each, and the site's branding
# stills are shot from them, so they are source rather than media.
!assets/marks/
!assets/marks/*
# The Metavillan marks. Unlike the scraped libraries there is no script that can
# fetch these back — they are a collected set, cropped and scaled for sprite use
# by npm run metavillan — so the sprite-sized copies are the source of record.
!assets/metavillan/
!assets/metavillan/*

# Generated exports, caches, datasets, PDFs, and media (videos, wav, LED samples, DJ cache, …)
artifacts/*
!artifacts/moon-cube-index.json
!artifacts/color-cubes/
!artifacts/sample-sonicsphere-silent.webm

# Where the car actually was, appended fix by fix by scripts/hermes-server.mjs.
# A week of driving is a record, not source, and it is the crew's business alone.
data/hermes/track*.jsonl

# The server's own https key and certificate, made on first run for whatever
# network the camp is on. A private key is never source, and these are specific
# to one wifi anyway — the next network gets a new pair.
data/hermes/tls/

# What went wrong on one machine, with times. Read it over http at
# /api/hermes/faults, or roll it up by hand into docs/hermes-incidents.md, which
# is the version worth keeping: this one is a machine's bad days, not source.
data/hermes/faults.jsonl
data/hermes/faults.jsonl.1

# The rest of what the server writes while it runs. This repo is public, and every
# one of these carries something that belongs to a person rather than to the project:
# the phone token is a live credential, and the logs hold positions, names, the
# messages people sent a pickup box, and the addresses they sent them from. The track
# log above was already spoken for; these are the same argument.
data/hermes/phone-token.txt
data/hermes/location-feed*.jsonl
data/hermes/pickup-requests.jsonl
data/hermes/art-closest*.jsonl
data/hermes/people-graph-events.jsonl
data/hermes/annals-comments.jsonl
data/hermes/annals-visits.json
# Offers to be part of next year. The worst of the lot to leak: every line is a name
# beside a working email or handle, given for one purpose. Nothing serves these back —
# the endpoint returns counts — so this file and the Postgres table are the only copies.
data/hermes/bookings.jsonl

# The key that turns names into the pseudonyms in people-graph-events.anon.jsonl. Commit
# this and the anonymised file stops being anonymous: anyone could HMAC a list of names
# and read the mapping straight off. The anon file itself is meant to be committed.
data/hermes/.anon-salt

# Scraped copies of the official events listing, a few megabytes each and re-fetched
# by `npm run hermes:events`. The timestamped ones are a scrape that was interrupted.
data/hermes/activities.json
data/hermes/activities.*.json
data/hermes/instagram-scrape.json
data/hermes/art/2025-track-near-art*.json*

video-manifest.json
audio-manifest.json
.pnpm-store/
pnpm-lock.yaml
